<svg xmlns="http://www.w3.org/2000/svg"
     width="400"
     height="400"
     viewBox="0 0 124 124"
     fill="none">

  <defs>
    <!-- Head gradient -->
    <linearGradient id="headGradient" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFF" />
      <stop offset="100%" stop-color="#777" />
    </linearGradient>
    <!-- Body gradient -->
    <linearGradient id="brainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3E5AB" />
      <stop offset="100%" stop-color="#222" />
    </linearGradient>
  </defs>

  <g stroke="#222"
     stroke-width="2"
     fill="url(#brainGradient)"
     stroke-linejoin="round"
     stroke-linecap="round"
     transform="translate(-13 -8)"
    >
    <!-- Right Hand -->
    <rect x="65" y="100" width="10" height="10" fill="url(#headGradient)" />
    <!-- Right Thumb -->
    <rect x="70" y="102.5" width="5" height="5" fill="url(#headGradient)" />
    
    <!-- Body -->
    <path d="
      M60 80
      L85 80
      L85 120
      L75 120
      L75 110
      L70 110
      L70 120
      L65 120
      L65 80
      Z
    " />
    
    <!-- Head -->
    <rect x="55" y="40" width="40" height="40" fill="url(#headGradient)" />
    <!-- Left eye -->
    <rect x="55" y="60" width="10" height="10" fill="#FFF" />
    <!-- Right eye -->
    <rect x="70" y="55" width="20" height="20" fill="#FFF" />
    <!-- Left eye pupil -->
    <rect x="60" y="65" width="2" height="2" fill="#222" />
    <!-- Right eye pupil -->
    <rect x="73" y="65" width="2" height="2" fill="#222" />
    <!-- Mouth -->
    <rect x="60" y="75" width="15" height="5" fill="#780606" />

    <!-- Left Hand -->
    <rect x="75" y="100" width="10" height="10" fill="url(#headGradient)" />
    
    <!-- Tear -->
    <rect x="85" y="70" width="5" height="5" fill="#00FFF0" />
    <!-- <rect x="85" y="115" width="5" height="5" fill="#00FFF0" /> -->
    
  </g>
</svg>