<svg xmlns="http://www.w3.org/2000/svg"
     width="400"
     height="400"
     viewBox="0 0 124 124"
     fill="none">

  <defs>
    <!-- Head gradient -->
    <linearGradient id="headGradient" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FFF" />
      <stop offset="100%" stop-color="#FFF" />
    </linearGradient>
    <!-- Body gradient -->
    <linearGradient id="brainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF" />
      <stop offset="100%" stop-color="#FFF" />
    </linearGradient>
  </defs>

  <g stroke="#222"
     stroke-width="2"
     fill="url(#brainGradient)"
     stroke-linejoin="round"
     stroke-linecap="round"
     transform="translate(-13 -8)"
    >
    <!-- Right Hand -->
    <rect x="45" y="100" width="10" height="10" fill="url(#headGradient)" />
    <!-- Right Thumb -->
    <!-- <rect x="70" y="102.5" width="5" height="5" fill="url(#headGradient)" /> -->
    
    <!-- Body -->
    <path d="
      M60 80
      L85 80
      L85 120
      L77.5 120
      L77.5 110
      L72.5 110
      L72.5 120
      L65 120
      L65 80
      Z
    " />


    <!-- Head -->
    <rect x="55" y="40" width="40" height="40" fill="url(#headGradient)" />
    <!-- Left eye -->
    <rect x="55" y="52.5" width="20" height="20" fill="#FFF" />
    <!-- Right eye -->
    <rect x="75" y="52.5" width="20" height="20" fill="#FFF" />
    <!-- Left eye pupil -->
    <rect x="80" y="65" width="2" height="2" fill="#222" />
    <!-- Right eye pupil -->
    <rect x="65" y="65" width="2" height="2" fill="#222" />
    <!-- Nose -->
    <rect x="72.5" y="75" width="5" height="2.5" fill="#222" />

    <!-- Left Hand -->
    <rect x="75" y="100" width="10" height="10" fill="url(#headGradient)" />
    
    <!-- Tear -->
    <!-- <rect x="85" y="70" width="5" height="5" fill="#00FFF0" /> -->
    <!-- <rect x="85" y="115" width="5" height="5" fill="#00FFF0" /> -->

    <!-- Right Ear -->
    <path d="M55 25 L55 40 L70 40 Z" />
    <!-- Left Ear -->
    <path d="M95 25 L95 40 L80 40 Z" />
    
  </g>
</svg>