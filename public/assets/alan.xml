    " />
    
    <!-- Head -->
    <rect x="55" y="20" width="40" height="60" fill="url(#headGradient)" />
    <!-- Left eye -->
    <rect x="58" y="55" width="15" height="20" fill="#222" />
    <!-- Right eye -->
    <rect x="77" y="55" width="15" height="20" fill="#222" />
    
