{
  "name": "my-video-factory",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.441",
    "@remotion/cli": "4.0.441",
    "@remotion/google-fonts": "4.0.441",
    "@remotion/media-parser": "4.0.441",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.441"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.441",
    "@types/react": "19.2.14",
    "@types/web": "0.0.345",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "validate": "powershell -ExecutionPolicy Bypass -File .\\validate-script.ps1",
    "audio": "npm run validate && powershell -ExecutionPolicy Bypass -File .\\generate-audio.ps1",
    "render:youtube": "powershell -ExecutionPolicy Bypass -File .\\render.ps1 -Composition Youtube",
    "render:shorts": "powershell -ExecutionPolicy Bypass -File .\\render.ps1 -Composition Shorts",
    "render": "powershell -ExecutionPolicy Bypass -File .\\render.ps1",
    "factory": "npm run audio && npm run render"
  }
}
